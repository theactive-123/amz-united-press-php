# AMZ United Press: Apache configuration (needs mod_rewrite; mod_headers, mod_deflate, mod_expires are optional but recommended)
# Relative rewrites support domain-root and subfolder installs; PHP detects the base path.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Force HTTPS (uncomment on a live site with an SSL certificate) ---
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Choose one canonical host (uncomment and edit) ---
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Never serve internal files ---
RewriteRule ^(includes|storage|partials)/ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule ^(README\.md|DESIGN\.md)$ - [F,L]

# --- Redirect /index.php and /page.php to the clean URL ---
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?([a-z0-9-]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !/(forms/|sitemap\.php(?:$|/)) [NC]
RewriteRule ^ /%1%2 [R=301,L]

# --- Sitemap ---
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- Clean service URLs: /services/ghostwriting -> service.php?slug=ghostwriting ---
RewriteRule ^services/([a-z0-9-]+)/?$ service.php?slug=$1 [L,QSA]

# --- Extensionless pages: /pricing -> pricing.php ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

# --- Remove trailing slash ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

# Custom 404 page without an installation-specific path.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
</IfModule>

# --- Security ---
<FilesMatch "(\.(log|ini|sh|sql|bak|md)|config\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"   # enable once HTTPS works
    <FilesMatch "\.(woff2|png|jpg|jpeg|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# --- PHP settings (ignored on servers that do not allow overrides) ---
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag session.cookie_httponly on
</IfModule>
