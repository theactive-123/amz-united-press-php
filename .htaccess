# AMZ United Press: Apache configuration (needs mod_rewrite; mod_headers, mod_deflate, mod_expires are optional but recommended)
# Relative rewrites support domain-root and subfolder installs; PHP detects the base path.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- One canonical address: https://amzunitedpress.com (no www) ---
# Works behind Cloudflare: requests that already arrived over HTTPS at Cloudflare are not redirected again.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP:CF-Visitor} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# --- Remove a trailing slash (before any page rewrite, so /pricing/ never serves a duplicate) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

# --- Never serve internal files ---
RewriteRule ^(includes|storage|partials)/ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule ^(README\.md|DESIGN\.md)$ - [F,L]
RewriteRule ^docs(/|$) - [F,L]

# --- Redirect /index.php and /page.php to the clean URL ---
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.*/)?([a-z0-9-]+)\.php[\s?] [NC]
RewriteCond %{REQUEST_URI} !/(forms/|sitemap\.php(?:$|/)) [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1%2 [R=301,L,NE]

# --- Sitemap ---
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- Common old or alternative page addresses -> current pages ---
RewriteRule ^(home|index\.html?)$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^about-us$ https://%{HTTP_HOST}/about [R=301,L]
RewriteRule ^contact-us$ https://%{HTTP_HOST}/contact [R=301,L]
RewriteRule ^(our-services|all-services)$ https://%{HTTP_HOST}/services [R=301,L]
RewriteRule ^(faqs|frequently-asked-questions)$ https://%{HTTP_HOST}/faq [R=301,L]
RewriteRule ^(privacy-policy|privacy-notice)$ https://%{HTTP_HOST}/privacy [R=301,L]
RewriteRule ^(terms-and-conditions|terms-of-service|terms-of-use)$ https://%{HTTP_HOST}/terms [R=301,L]
RewriteRule ^(packages|plans)$ https://%{HTTP_HOST}/pricing [R=301,L]
RewriteRule ^(our-work|work|testimonials|reviews)$ https://%{HTTP_HOST}/portfolio [R=301,L]
RewriteRule ^(process|our-process)$ https://%{HTTP_HOST}/how-it-works [R=301,L]

# --- Old service addresses -> new pages (permanent redirects keep search rankings) ---
RewriteRule ^services/ghostwriting/?$ https://%{HTTP_HOST}/services/ghostwriting-services [R=301,L]
RewriteRule ^services/book-outlining/?$ https://%{HTTP_HOST}/services/ebook-writing-services [R=301,L]
RewriteRule ^services/(developmental-editing|copyediting)/?$ https://%{HTTP_HOST}/services/book-editing-services [R=301,L]
RewriteRule ^services/proofreading/?$ https://%{HTTP_HOST}/services/proofreading-services [R=301,L]
RewriteRule ^services/cover-design/?$ https://%{HTTP_HOST}/services/book-cover-design-services [R=301,L]
RewriteRule ^services/(interior-layout|ebook-formatting)/?$ https://%{HTTP_HOST}/services/book-formatting-services [R=301,L]
RewriteRule ^services/(publishing-distribution|ebook-publishing-services|amazon-publishing-services)/?$ https://%{HTTP_HOST}/services/publishing-services [R=301,L]
RewriteRule ^services/book-marketing/?$ https://%{HTTP_HOST}/services/book-marketing-services [R=301,L]

# --- Clean service URLs: /services/ghostwriting-services -> service.php?slug=ghostwriting-services ---
RewriteRule ^services/([a-z0-9-]+)/?$ service.php?slug=$1 [L,QSA]

# --- Ad landing pages: /lp/writing-services -> lp/writing-services.php ---
RewriteRule ^lp/?$ https://%{HTTP_HOST}/services [R=301,L]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^lp/([a-z0-9-]+)$ lp/$1.php [L]

# --- Blog articles: /blog/how-much-does-it-cost-to-self-publish-a-book -> post.php?slug=... ---
RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]

# --- Extensionless pages: /pricing -> pricing.php ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

# Custom 404 page without an installation-specific path.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
</IfModule>

# --- Security ---
<FilesMatch "(\.(log|ini|sh|sql|bak|md)|config\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"   # enable once HTTPS works
    <FilesMatch "\.(woff2|png|jpg|jpeg|webp|avif|svg|ico|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS/JS URLs change with every edit (?v=… or a hashed bundle name), so they can be cached for a year.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# --- PHP settings (ignored on servers that do not allow overrides) ---
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag session.cookie_httponly on
</IfModule>
