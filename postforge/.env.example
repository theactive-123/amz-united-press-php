# Copy this file to .env.local and fill in your own keys.
# Never commit .env.local and never paste keys into chat.

# Required. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Check the current model names at
# https://ai.google.dev/gemini-api/docs/models (and confirm the "Free tier" on
# https://ai.google.dev/gemini-api/docs/pricing).
GEMINI_MODEL=gemini-3.6-flash
# Optional. Backup Gemini models (comma separated), tried in order when the main one is
# busy or out of free quota. Each model has its own free daily quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional fallback. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
